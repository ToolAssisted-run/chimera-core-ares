+// Chimera: through a staging buffer in cached memory, since reading the
+// device's own memory - or memory it can see but the CPU does not cache - is
+// slow on a real card.
+static void chimera_copy_from_device(Vulkan::Device &device, const Vulkan::Buffer &src, void *data, size_t size)
+{
+	BufferCreateInfo info = {};
+	info.size = size;
+	info.usage = VK_BUFFER_USAGE_TRANSFER_DST_BIT;
+	info.domain = BufferDomain::CachedHost;
+	auto staging = device.create_buffer(info);
+	auto cmd = device.request_command_buffer();
+	cmd->barrier(VK_PIPELINE_STAGE_2_ALL_COMMANDS_BIT, VK_ACCESS_2_MEMORY_WRITE_BIT,
+	             VK_PIPELINE_STAGE_2_COPY_BIT, VK_ACCESS_2_TRANSFER_READ_BIT);
+	cmd->copy_buffer(*staging, 0, src, 0, size);
+	cmd->barrier(VK_PIPELINE_STAGE_2_COPY_BIT, VK_ACCESS_2_TRANSFER_WRITE_BIT,
+	             VK_PIPELINE_STAGE_HOST_BIT, VK_ACCESS_2_HOST_READ_BIT);
+	Fence fence;
+	device.submit(cmd, &fence);
+	fence->wait();
+	memcpy(data, device.map_host_buffer(*staging, MEMORY_ACCESS_READ_BIT), size);
+	device.unmap_host_buffer(*staging, MEMORY_ACCESS_READ_BIT);
+}
+
+static void chimera_copy_to_device(Vulkan::Device &device, const Vulkan::Buffer &dst, const void *data, size_t size)
+{
+	BufferCreateInfo info = {};
+	info.size = size;
+	info.usage = VK_BUFFER_USAGE_TRANSFER_SRC_BIT;
+	info.domain = BufferDomain::CachedHost;
+	auto staging = device.create_buffer(info, data);
+	auto cmd = device.request_command_buffer();
+	cmd->barrier(VK_PIPELINE_STAGE_2_ALL_COMMANDS_BIT, VK_ACCESS_2_MEMORY_READ_BIT | VK_ACCESS_2_MEMORY_WRITE_BIT,
+	             VK_PIPELINE_STAGE_2_COPY_BIT, VK_ACCESS_2_TRANSFER_WRITE_BIT);
+	cmd->copy_buffer(dst, 0, *staging, 0, size);
+	cmd->barrier(VK_PIPELINE_STAGE_2_COPY_BIT, VK_ACCESS_2_TRANSFER_WRITE_BIT,
+	             VK_PIPELINE_STAGE_2_ALL_COMMANDS_BIT, VK_ACCESS_2_MEMORY_READ_BIT | VK_ACCESS_2_MEMORY_WRITE_BIT);
+	Fence fence;
+	device.submit(cmd, &fence);
+	fence->wait();
+}
+
+void CommandProcessor::chimera_read_tmem(void *data)
+{
+	chimera_copy_from_device(device, *tmem, data, tmem->get_create_info().size);
+}
+
+void CommandProcessor::chimera_write_tmem(const void *data)
+{
+	chimera_copy_to_device(device, *tmem, data, tmem->get_create_info().size);
+}
+
+void CommandProcessor::chimera_read_hidden_rdram(void *data, size_t size)
+{
+	chimera_copy_from_device(device, *hidden_rdram, data, std::min<size_t>(size, hidden_rdram->get_create_info().size));
+}
+
+void CommandProcessor::chimera_write_hidden_rdram(const void *data, size_t size)
+{
+	chimera_copy_to_device(device, *hidden_rdram, data, std::min<size_t>(size, hidden_rdram->get_create_info().size));
+}
