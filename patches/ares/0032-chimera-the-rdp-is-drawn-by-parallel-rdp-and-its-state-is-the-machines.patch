+auto Vulkan::keep(u32 code, const u32* words) -> void {
+  switch(code) {
+  case 0x2a: case 0x2b: case 0x2c: case 0x2d: case 0x2e: case 0x2f:
+  case 0x37: case 0x38: case 0x39: case 0x3a: case 0x3b: case 0x3c: case 0x3d: case 0x3e: case 0x3f:
+    kept.state[code][0] = words[0];
+    kept.state[code][1] = words[1];
+    kept.stateSet |= 1ull << code;
+    break;
+  case 0x35: {  //SetTile
+    u32 tile = words[1] >> 24 & 7;
+    kept.tile[tile][0] = words[0];
+    kept.tile[tile][1] = words[1];
+    kept.tileSet |= 1 << tile;
+    break;
+  }
+  case 0x30: case 0x32: case 0x33: case 0x34: {
+    //SetTileSize, and the three loads, which leave the tile the same size
+    //(paraLLEl-RDP reads the same four fields from all of them): kept as the
+    //SetTileSize they amount to, since a load would load again
+    u32 tile = words[1] >> 24 & 7;
+    kept.tileSize[tile][0] = (words[0] & ~(63u << 24)) | 0x32u << 24;
+    kept.tileSize[tile][1] = words[1];
+    kept.tileSizeSet |= 1 << tile;
+    break;
+  }
+  }
+}
+
+auto Vulkan::checkContext() -> void {
+  if(!implementation) return;
+  #if defined(CHIMERA_VK_BRIDGE)
+  if(implementation->contextId != chimera_vk_context_id()) { rebuild(); return; }
+  #endif
+  if(kept.restorePending) rebuild();
+}
+
+auto Vulkan::rebuild() -> void {
+  kept.restorePending = false;
+  //a command cut in two by the end of a list stays to be finished
+  u32 queueSize = 0, queueOffset = 0;
+  static u32 queue[0x10000];
+  if(implementation) {
+    queueSize = implementation->queueSize;
+    queueOffset = implementation->queueOffset;
+    memory::copy(queue, implementation->buffer, sizeof(queue));
+  }
+  unload();
+  implementation = new Vulkan::Implementation(rdram.ram.data, rdram.ram.size);
+  if(!implementation->processor) {
+    delete implementation;
+    implementation = nullptr;
+    vulkan.enable = false;
+    return;
+  }
+  implementation->queueSize = queueSize;
+  implementation->queueOffset = queueOffset;
+  memory::copy(implementation->buffer, queue, sizeof(queue));
+  auto& processor = *implementation->processor;
+  if(kept.valid) {
+    processor.chimera_write_tmem(kept.tmem);
+    processor.chimera_write_hidden_rdram(kept.hidden, sizeof(kept.hidden));
+    processor.chimera_set_noise_base(kept.noiseBase);
+  }
+  for(u32 code : range(64)) {
+    if(kept.stateSet >> code & 1) processor.enqueue_command(2, kept.state[code]);
+  }
+  for(u32 tile : range(8)) {
+    if(kept.tileSet >> tile & 1) processor.enqueue_command(2, kept.tile[tile]);
+    if(kept.tileSizeSet >> tile & 1) processor.enqueue_command(2, kept.tileSize[tile]);
+  }
+  for(u32 reg : range(16)) {
+    if(kept.viSet >> reg & 1) processor.set_vi_register(::RDP::VIRegister(reg), kept.vi[reg]);
+  }
+  if(kept.valid) processor.chimera_write_vi_history(kept.viCounters, kept.viPicture, kept.viWidth, kept.viHeight);
+}
+
+auto Vulkan::idle() -> void {
+  checkContext();
+  if(!implementation) return;
+  implementation->processor->idle();
+}
+
+auto Vulkan::stateSaving() -> void {
+  //Nothing has run since a load: what is kept is what was loaded, and a
+  //state taken now is the same bytes as the one loaded.
+  if(kept.restorePending) return;
+  #if defined(CHIMERA_VK_BRIDGE)
+  if(implementation && implementation->contextId != chimera_vk_context_id()) return;
+  #endif
+  if(!implementation) return;
+  auto& processor = *implementation->processor;
+  processor.idle();
+  processor.chimera_read_tmem(kept.tmem);
+  processor.chimera_read_hidden_rdram(kept.hidden, sizeof(kept.hidden));
+  kept.noiseBase = processor.chimera_noise_base();
+  unsigned width = 0, height = 0;
+  processor.chimera_read_vi_history(kept.viCounters, kept.viPicture, sizeof(kept.viPicture), width, height);
+  kept.viWidth = width;
+  kept.viHeight = height;
+  kept.valid = true;
+}
+
+auto Vulkan::serialize(serializer& s) -> void {
+  if(s.writing()) stateSaving();
+  s(kept.valid);
+  s(kept.stateSet);
+  s(kept.tileSet);
+  s(kept.tileSizeSet);
+  s(kept.viSet);
+  s(kept.noiseBase);
+  s(kept.viCounters);
+  s(kept.viWidth);
+  s(kept.viHeight);
+  s(kept.viPicture);
+  for(auto& w : kept.state) s(w);
+  for(auto& w : kept.tile) s(w);
+  for(auto& w : kept.tileSize) s(w);
+  s(kept.vi);
+  s(kept.tmem);
+  s(kept.hidden);
+  if(s.reading()) kept.restorePending = true;
+}
