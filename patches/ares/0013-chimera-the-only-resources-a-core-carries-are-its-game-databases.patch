--- a/mia/medium/medium.cpp
+++ b/mia/medium/medium.cpp
@@ -105,6 +105,27 @@
     return true;
   }
 
+  //Failing a file on disk, the copy compiled in. A core has no filesystem to
+  //keep these on, and without them mia cannot answer questions a game file does
+  //not answer for itself: which of two wirings a 16KB Atari 5200 cartridge
+  //uses, what board a Famicom cartridge really has (its header is often wrong),
+  //or what a Neo Geo romset is at all. Only the databases the machines on offer
+  //need are carried; the rest would be weight for nothing.
+  struct Builtin { const char* name; const u8* data; u32 size; };
+  static const Builtin builtins[] = {
+    {"Atari 5200", Resource::Database::Atari5200, sizeof(Resource::Database::Atari5200)},
+    {"Famicom",    Resource::Database::Famicom,   sizeof(Resource::Database::Famicom)},
+    {"MSX",        Resource::Database::MSX,       sizeof(Resource::Database::MSX)},
+    {"MSX2",       Resource::Database::MSX2,      sizeof(Resource::Database::MSX2)},
+    {"Neo Geo",    Resource::Database::NeoGeo,    sizeof(Resource::Database::NeoGeo)},
+  };
+  for(auto& builtin : builtins) {
+    if(database.name != builtin.name) continue;
+    database.list = BML::unserialize(string{(const char*)builtin.data, builtin.size});
+    Media::databases.push_back(std::move(database));
+    return true;
+  }
+
   return false;
 }
 
