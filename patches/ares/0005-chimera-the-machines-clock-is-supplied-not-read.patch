diff --git a/ares/n64/system/system.hpp b/ares/n64/system/system.hpp
index 1c6bda60c..144ddec5c 100644
--- a/ares/n64/system/system.hpp
+++ b/ares/n64/system/system.hpp
@@ -51,6 +51,15 @@ private:
 extern System system;
 extern Random random;
 
+//The machine's wall clock, in Unix seconds. A movie replayed next year must
+//produce the same machine it produced today, so the time an RTC starts from is
+//something the frontend states and a movie records - never something read off
+//the host. It advances only when the frontend says so.
+//
+//It is read as UTC for the same reason: localtime() would make the machine
+//depend on the timezone of whoever is replaying.
+extern u64 rtcEpoch;
+
 auto Model::Nintendo64() -> bool { return system.model() == System::Model::Nintendo64; }
 auto Model::Aleck64() -> bool { return system.model() == System::Model::Aleck64; }
 auto Region::NTSC() -> bool { return system.region() == System::Region::NTSC; }
