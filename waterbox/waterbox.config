  "machineSetting": "machine",
  "firmware": [
    {
      "id": "gbBoot",
      "display": "Game Boy boot ROM",
      "description": "The Game Boy's boot ROM (256 bytes). It scrolls the logo and checks the cartridge. The core runs it and the game starts from the state it leaves, so it is required. It is Nintendo's and you have to supply it. The boot ROM of any original Game Boy revision works. DMG-CPU A is the one ares expects for a plain Game Boy.",
      "size": 256,
      "sha1": "4ED31EC6B0B175BB109C0EB5FD3D193DA823339F",
      "name": "dmg_boot.bin",
      "requiredWhen": {
        "setting": "machine",
        "in": [
          "gb"
        ]
      }
    },
    {
      "id": "gbcBoot",
      "display": "Game Boy Color boot ROM",
      "description": "The Game Boy Color's boot ROM (2 KB). It is larger than the Game Boy's because it also chooses the colours an original Game Boy cartridge is shown in.",
      "size": 2048,
      "sha1": "6F4115B7E55849472D1BD134289EAB937D001246",
      "name": "cgb_boot.bin",
      "requiredWhen": {
        "setting": "machine",
        "in": [
          "gbc"
        ]
      }
    },
    {
      "id": "wsBoot",
      "display": "WonderSwan boot ROM",
      "description": "The WonderSwan's boot ROM. It shows the startup animation, sets the machine up and reads the owner's name from the console's memory.",
      "size": 4096,
      "sha1": "4015BCACEA76BB0B5BBDB13C5358F7E1ABB986A1",
      "name": "ws_boot.rom",
      "requiredWhen": {
        "setting": "machine",
        "in": [
          "ws"
        ]
      }
    },
    {
      "id": "wscBoot",
      "display": "WonderSwan Color boot ROM",
      "description": "The WonderSwan Color's boot ROM. It is a different file from the WonderSwan's.",
      "size": 8192,
      "sha1": "C5AD0B8AF45D762662A69F50B64161B9C8919EFB",
      "name": "wsc_boot.rom",
      "requiredWhen": {
        "setting": "machine",
        "in": [
          "wsc"
        ]
      }
    },
    {
      "id": "zxsBios",
      "display": "ZX Spectrum BIOS",
      "description": "The ZX Spectrum's ROM (16 KB). It holds the BASIC language, the editor and the tape loader, so the machine cannot run without it. Amstrad owns it and allows it to be distributed with emulators. This core does not include it, and you have to supply it.",
      "size": 16384,
      "sha1": "5EA7C2B824672E914525D1D5C419D71B84A426A2",
      "name": "spectrum.rom",
      "requiredWhen": {
        "setting": "machine",
        "in": [
          "zxs"
        ]
      }
    },
    {
      "id": "gbaBios",
      "display": "Game Boy Advance BIOS",
      "description": "The Game Boy Advance's boot ROM (16 KB). The real one is needed. The core runs it, games call functions in it and its timing is part of the machine. It is Nintendo's and you have to supply it.",
      "size": 16384,
      "sha1": "300C20DF6731A33952DED8C436F7F186D25D3492",
      "name": "GBA_bios.rom",
      "requiredWhen": {
        "setting": "machine",
        "in": [
          "gba"
        ]
      }
    },
    {
      "id": "cvBios",
      "display": "ColecoVision BIOS",
      "description": "The ColecoVision's boot ROM (8 KB). It holds the console's title screen and its cartridge checks, and nothing runs without it.",
      "size": 8192,
      "sha1": "45BEDC4CBDEAC66C7DF59E9E599195C778D86A92",
      "name": "Coleco_Bios.bin",
      "requiredWhen": {
        "setting": "machine",
        "in": [
          "cv"
        ]
      }
    },
    {
      "id": "msxBios",
      "display": "MSX BIOS",
      "description": "The MSX's BIOS and BASIC ROM (32 KB). The ROM of any MSX machine works, and they differ by region. The one named here is the one this core was tested with. A project records which one it used.",
      "size": 32768,
      "sha1": "409E82ADAC40F6BDD18EB6C84E8B2FBDC7FB5498",
      "name": "MSX.rom",
      "requiredWhen": {
        "setting": "machine",
        "in": [
          "msx"
        ]
      }
    },
    {
      "id": "ps1Bios",
      "display": "PlayStation BIOS",
      "description": "The PlayStation's boot ROM (512 KB). It is the console's operating system. Games call it all the time and nothing runs without it. It is Sony's and you have to supply it. Any retail BIOS works, and they differ by region and revision. The one named here is the one this core was tested with. A project records which one it used.",
      "size": 524288,
      "sha1": "14DF4F6C1E367CE097C11DEAE21566B4FE5647A9",
      "name": "PSX_4.1(A).bin",
      "requiredWhen": {
        "setting": "machine",
        "in": [
          "ps1"
        ]
      }
    },
    {
      "id": "a52Bios",
      "display": "Atari 5200 BIOS",
      "description": "The Atari 5200's boot ROM. It must be exactly 2048 bytes, and a file of any other size is refused.",
      "size": 2048,
      "sha1": "6AD7A1E8C9FAD486FBEC9498CB48BF5BC3ADC530",
      "name": "[BIOS] Atari 5200 (USA).a52",
      "requiredWhen": {
        "setting": "machine",
        "in": [
          "a52"
        ]
      }
    },
    {
      "id": "ngpBios",
      "display": "Neo Geo Pocket BIOS",
      "description": "The boot ROM of the original black-and-white Neo Geo Pocket (64 KB). Its name usually carries the year 1998, which tells it apart from the Color one.",
      "size": 65536,
      "sha1": "2F6429B68446536D8B03F35D02F1E98BEB6460A0",
      "name": "SNK Neo-Geo Pocket BIOS (1998)(SNK)(en-ja).bin",
      "requiredWhen": {
        "setting": "machine",
        "in": [
          "ngp"
        ]
      }
    },
    {
      "id": "ngpcBios",
      "display": "Neo Geo Pocket Color BIOS",
      "description": "The boot ROM of the Neo Geo Pocket Color (64 KB). It is a different ROM from the black-and-white machine's, and one cannot be used in place of the other.",
      "size": 65536,
      "sha1": "EDC13192054A59BE49C6D55F83B70E2510968E86",
      "name": "SNK Neo-Geo Pocket Color BIOS (1999)(SNK)(en-ja).bin",
      "requiredWhen": {
        "setting": "machine",
        "in": [
          "ngpc"
        ]
      }
    },
    {
      "id": "ngBios",
      "display": "Neo Geo AES BIOS",
      "description": "The boot ROM of the Neo Geo home console (128 KB). The file is `neo-epo.bin`. It is usually found inside an `aes.zip` BIOS set and has to be taken out of the zip first.",
      "size": 131072,
      "sha1": "1B3B22092F30C4D1B2C15F04D1670EB1E9FBEA07",
      "name": "neo-epo.bin",
      "requiredWhen": {
        "setting": "machine",
        "in": [
          "ng"
        ]
      }
    },
    {
      "id": "sfcIpl",
      "display": "Super Famicom IPL (SPC700 boot ROM)",
      "description": "The 64 bytes the SNES sound processor runs when the console is switched on. The main processor uses them to load sound code, so nothing plays without this file. It is Nintendo's and you have to supply it. Games with an extra chip in the cartridge (the DSP-1 in Pilotwings, the CX4 in Mega Man X2) also need that chip's ROM. This core does not ask for those yet.",
      "size": 64,
      "sha1": "97E352553E94242AE823547CD853EECDA55C20F0",
      "name": "ipl.rom",
      "requiredWhen": {
        "setting": "machine",
        "in": [
          "sfc"
        ]
      }
    },
    {
      "id": "m32xVector",
      "display": "Mega 32X vector table",
      "description": "The 256-byte table the Mega Drive's 68000 processor starts from on a 32X. It is Sega's and you have to supply it. The three 32X files come from the same dump. The letter in each name says which processor runs it: G for the Mega Drive side, M and S for the two SH-2 processors.",
      "size": 256,
      "sha1": "DBEBD76A448447CB6E524AC3CB0FD19FC065D944",
      "name": "32X_G_BIOS.bin",
      "requiredWhen": {
        "setting": "machine",
        "in": [
          "32x",
          "mcd32x"
        ]
      }
    },
    {
      "id": "m32xBootM",
      "display": "Mega 32X master SH-2 boot ROM",
      "description": "The boot ROM of the first of the 32X's two SH-2 processors (2 KB).",
      "size": 2048,
      "sha1": "1E5B0B2441A4979B6966D942B20CC76C413B8C5E",
      "name": "32X_M_BIOS.bin",
      "requiredWhen": {
        "setting": "machine",
        "in": [
          "32x",
          "mcd32x"
        ]
      }
    },
    {
      "id": "m32xBootS",
      "display": "Mega 32X slave SH-2 boot ROM",
      "description": "The boot ROM of the second of the 32X's two SH-2 processors (1 KB).",
      "size": 1024,
      "sha1": "4103668C1BBD66C5E24558E73D4F3F92061A109A",
      "name": "32X_S_BIOS.bin",
      "requiredWhen": {
        "setting": "machine",
        "in": [
          "32x",
          "mcd32x"
        ]
      }
    },
    {
      "id": "msx2Main",
      "display": "MSX2 main BIOS",
      "description": "The MSX2's main ROM (32 KB). It belongs to Microsoft and ASCII, and you have to supply it. An MSX2 also needs its sub ROM.",
      "size": 32768,
      "sha1": "6103B39F1E38D1AA2D84B1C3219C44F1ABB5436E",
      "name": "msx2.rom",
      "requiredWhen": {
        "setting": "machine",
        "in": [
          "msx2"
        ]
      }
    },
    {
      "id": "msx2Sub",
      "display": "MSX2 sub ROM",
      "description": "The MSX2's sub ROM (16 KB). It holds the extended BIOS that the main ROM calls.",
      "size": 16384,
      "sha1": "5C1F9C7FB655E43D38E5DD1FCC6B942B2FF68B02",
      "name": "msx2ext.rom",
      "requiredWhen": {
        "setting": "machine",
        "in": [
          "msx2"
        ]
      }
    },
    {
      "id": "megaCdBios",
      "display": "Mega CD / Sega CD BIOS",
      "description": "The BIOS of the Mega CD disc drive. It is Sega's and you have to supply it. A disc only starts with the BIOS of its own region. A USA game needs the Sega CD BIOS and a Japanese game the Japanese Mega CD BIOS. The Model 1 and Model 2 versions both work. They show a different menu, and games behave the same on both.",
      "size": 131072,
      "sha1": "5A8C4B91D3034C1448AAC4B5DC9A6484FCE51636",
      "name": "SCD_m2_us_200.bin",
      "requiredWhen": {
        "all": [
          {
            "setting": "machine",
            "in": [
              "mcd",
              "mcd32x"
            ]
          },
          {
            "setting": "mcd.bios",
            "is": "usa"
          }
        ]
      }
    },
    {
      "id": "megaCdBios",
      "display": "Mega CD / Sega CD BIOS",
      "description": "The BIOS of the Mega CD disc drive. It is Sega's and you have to supply it. A disc only starts with the BIOS of its own region. A USA game needs the Sega CD BIOS and a Japanese game the Japanese Mega CD BIOS. The Model 1 and Model 2 versions both work. They show a different menu, and games behave the same on both.",
