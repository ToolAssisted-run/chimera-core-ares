    {
      "name": "ng.normalController",
      "display": "Neo Geo AES: Normal Controller",
      "description": "One of the Neo Geo system board's switches. It tells the system ROM that an ordinary controller is connected, and not a mahjong one.",
      "type": "bool",
      "fromAres": true,
      "when": [
        "ng"
      ],
      "default": true
    },
    {
      "name": "ng.multiplayer",
      "display": "Neo Geo AES: Multiplayer",
      "description": "One of the Neo Geo system board's switches. It turns on play between linked machines.",
      "type": "bool",
      "fromAres": true,
      "when": [
        "ng"
      ],
      "default": true
    },
    {
      "name": "ng.freePlay",
      "display": "Neo Geo AES: Free Play",
      "description": "One of the Neo Geo system board's switches. It lets a game start without coins.",
      "type": "bool",
      "fromAres": true,
      "when": [
        "ng"
      ],
      "default": true
    },
    {
      "name": "ng.freeze",
      "display": "Neo Geo AES: Freeze",
      "description": "One of the Neo Geo system board's switches. On an arcade board it stops the game while it is set.",
      "type": "bool",
      "fromAres": true,
      "when": [
        "ng"
      ],
      "default": true
    },
    {
      "name": "ng.communicationID",
      "display": "Neo Geo AES: Communication ID",
      "description": "The number this machine has when several are linked together.",
      "type": "enum",
      "fromAres": true,
      "when": [
        "ng"
      ],
      "default": "3",
      "options": [
        "0",
        "1",
        "2",
        "3"
      ]
    },
    {
      "name": "sfc.version",
      "display": "Super Famicom / SNES: Version",
      "description": "Which revision of the console this is. Revisions of the real console behave differently in small ways, and a game that depends on one may act differently on another.",
      "type": "enum",
      "fromAres": true,
      "when": [
        "sfc"
      ],
      "default": "2",
      "options": [
        "1",
        "2"
      ]
    },
    {
      "name": "sfc.deepBlackBoost",
      "display": "Super Famicom / SNES: Deep Black Boost",
      "description": "Makes the darkest colours darker, as a television showed them. It changes the picture only.",
      "type": "bool",
      "fromAres": true,
      "when": [
        "sfc"
      ],
      "default": true
    },
    {
      "name": "sfc.pPU1Version",
      "display": "Super Famicom / SNES: PPU1 Version",
      "description": "The revision number of the first of the console's two video chips. A game can read it.",
      "type": "enum",
      "fromAres": true,
      "when": [
        "sfc"
      ],
      "default": "1",
      "options": [
        "1"
      ]
    },
    {
      "name": "sfc.pPU2Version",
      "display": "Super Famicom / SNES: PPU2 Version",
      "description": "The revision number of the second of the console's two video chips. A game can read it.",
      "type": "enum",
      "fromAres": true,
      "when": [
        "sfc"
      ],
      "default": "3",
      "options": [
        "1",
        "2",
        "3"
      ]
    },
    {
      "name": "sfc.vRAM",
      "display": "Super Famicom / SNES: VRAM",
      "description": "How much video memory the console has. A real console has 64 KB.",
      "type": "enum",
      "fromAres": true,
      "when": [
        "sfc"
      ],
      "default": "65536",
      "options": [
        "65536",
        "131072"
      ]
    },
    {
      "name": "pce.colorEmulation",
      "display": "PC Engine / TurboGrafx-16: Color Emulation",
      "description": "Shows the colours the way the console's own screen showed them, and not the raw values as a modern display would show them. It changes the recorded picture.",
      "type": "bool",
      "fromAres": true,
      "when": [
        "pce"
      ],
      "default": true
    },
    {
      "name": "sgx.colorEmulation",
      "display": "SuperGrafx: Color Emulation",
      "description": "Shows the colours the way the console's own screen showed them, and not the raw values as a modern display would show them. It changes the recorded picture.",
      "type": "bool",
      "fromAres": true,
      "when": [
        "sgx"
      ],
      "default": true
    },
    {
      "name": "pcecd.colorEmulation",
      "display": "PC Engine CD / TurboDuo: Color Emulation",
      "description": "Shows the colours the way the console's own screen showed them, and not the raw values as a modern display would show them. It changes the recorded picture.",
      "type": "bool",
      "fromAres": true,
      "when": [
        "pcecd"
      ],
      "default": true
    }
  ],
  "_machines_note": "ONE core.wbx, many machines. ares is one emulator for about thirty consoles - the same binary with different hardware built - so this package is all of the ones it can build without asking the user for a console BIOS. What they share stays above; what makes them different machines is below, and it is GENERATED from ares itself by waterbox/gen-config.py, because the order of a controller's buttons is what a movie is written in. Which machine a session is comes from the machine setting, so a project pins it and a movie cites it.",
  "machines": [
