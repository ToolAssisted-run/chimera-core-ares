    {
      "name": "initialTime",
      "display": "Starting Clock",
      "description": "What the cartridge's real-time clock reads when the machine powers on, in Unix seconds. Only a handful of carts have one. It is a setting rather than the host's clock because a movie replayed next year must build the same machine as today's.",
      "type": "int",
      "min": 0,
      "max": 2147483647,
      "default": 0,
      "when": [
        "n64"
      ]
    },
    {
      "name": "fastVI",
      "display": "Skip Video Filtering",
      "description": "Skips the video interface's divot, anti-alias and gamma passes. Faster, and a slightly different picture; it does not touch the emulated machine, but it does change what a video encode looks like, so it is recorded.",
      "type": "bool",
      "default": false,
      "when": [
        "n64"
      ]
    },
    {
      "name": "bobDeinterlace",
      "display": "Bob Deinterlacing",
      "description": "How an interlaced field is doubled into a full frame: bob rather than weave. Picture only.",
      "type": "bool",
      "default": false,
      "when": [
        "n64"
      ]
    },
    {
      "name": "sms.colorEmulation",
      "display": "Master System: Color Emulation",
      "description": "Reproduce the screen's own colours rather than sending the machine's raw values to a modern display. Changes the recorded picture.",
      "type": "bool",
      "fromAres": true,
      "when": [
        "sms"
      ],
      "default": true
    },
    {
      "name": "sms.revision",
      "display": "Master System: Revision",
      "description": "Which revision of the console this is. Real revisions differ in behaviour, and a game that depends on one will not do the same on another.",
      "type": "enum",
      "fromAres": true,
      "when": [
        "sms"
      ],
      "default": "2",
      "options": [
        "1",
        "2"
      ]
    },
    {
      "name": "gg.interframeBlending",
      "display": "Game Gear: Interframe Blending",
      "description": "Average each frame with the one before it, the way an LCD of the period smeared. It is how the machine LOOKS, not what it does - but the frontend records the blended picture, so a movie's video differs with it on.",
      "type": "bool",
      "fromAres": true,
      "when": [
        "gg"
      ],
      "default": true
    },
    {
      "name": "gg.revision",
      "display": "Game Gear: Revision",
      "description": "Which revision of the console this is. Real revisions differ in behaviour, and a game that depends on one will not do the same on another.",
