{
  "coreName": "ares",
  "author": "ares team (Near, Themaister and contributors); RDP by angrylion; chimera port by Sergio Martin",
  "url": "https://github.com/ToolAssisted-run/chimera-core-ares",
  "romFile": "rom",
  "deterministic": true,
  "memoryLayoutMiB": [
    32,
    4,
    16,
    4,
    2048
  ],
  "_memoryLayoutMiB_note": "sbrk, sealed, invisible, plain, mmap. musl sends every large allocation to mmap, so that is the one that runs out. mia holds the whole medium in memory while it loads it, and a PlayStation disc is the big one: a 622MB image needs more than 768MB there and runs in 1024, so about one and a half times the image. 2048 covers the largest CD anybody will hand it. It costs address space and not much else - the disc pages are never written, so they are not dirty and a PlayStation savestate with a disc loaded is 5.3MB. Streaming the medium instead of holding it is the real fix and nobody has written it. sbrk is 32 rather than 16 because the Famicom wants more than 16 while mia works out what board a cartridge has. Raising either is free: a savestate holds the pages that were touched, not the ones that were offered.",
  "video": {
    "_comment": "buffer CAPACITY; the live size comes from GetVideoWidth/Height per frame. The rasteriser always writes 640 across; the height follows the video mode and is doubled for a 240-line picture, so 480 (NTSC) or 576 (PAL).",
    "width": 1280,
    "height": 576,
    "virtualWidth": 640,
    "virtualHeight": 480,
    "vsyncNumerator": 60,
    "vsyncDenominator": 1,
    "getBgra": "GetVideoBgra",
    "_vsync_note": "The NTSC machine's nominal rate; a PAL project gets 50 from GetVsyncNumerator/Denominator, which is what the frontend actually uses. Nominal because the real rate is whatever the game programs the video interface to produce."
  },
  "audio": {
    "samplesPerFrame": 4096,
    "channels": 2,
    "get": "GetAudio"
  },
  "lag": {
    "inputWasRead": "InputWasRead"
  },
  "settings": [
    {
      "name": "machine",
      "display": "Machine",
      "description": "Which console this project is for. Everything else depends on it, so changing it restarts the core.",
      "type": "enum",
      "options": [
        "n64",
        "nes",
        "gen",
        "sms",
        "gg",
        "sg",
        "a26",
        "myv",
        "gb",
        "gbc",
        "ws",
        "wsc",
        "zxs",
        "gba",
        "cv",
        "msx",
        "ps1",
        "a52",
        "ngp",
        "ngpc",
        "ng",
        "sfc",
        "32x",
        "msx2",
        "mcd",
        "pce",
        "sgx",
        "mcd32x",
        "pcecd"
      ],
      "default": "n64"
    },
    {
      "name": "region",
      "display": "Region",
      "description": "Whether the console is an NTSC or a PAL model. The two differ in video timing and in the boot ROM, so a movie made on one does not play back on the other. Changing it restarts the core.",
      "type": "enum",
      "options": [
        "ntsc",
        "pal"
      ],
      "default": "ntsc",
      "when": [
        "n64",
        "nes",
        "gen",
        "sms",
        "sg",
        "a26",
        "cv",
        "msx",
        "ps1",
        "sfc",
        "32x",
        "msx2",
        "mcd",
        "mcd32x"
      ]
    },
    {
      "name": "port1",
      "display": "Controller Port 1",
      "description": "What is plugged into the first controller port. 'default' is the device this machine normally has there, and 'none' leaves the port empty. Each of the other choices exists on certain machines only, and choosing one on a machine that does not have it is refused. They are arcadeStick (Neo Geo), controlPad (Mega Drive), controller (Atari 5200), digitalGamepad (PlayStation), ePSM (NES), gamepad (Nintendo 64, NES, Master System, Game Gear, SG-1000, Atari 2600, ColecoVision, MSX), memoryCard (PlayStation, Neo Geo) and mouse (Nintendo 64). The keyboard of an MSX or a ZX Spectrum is part of the machine and is not chosen here.",
      "type": "enum",
      "options": [
        "default",
        "none",
        "arcadeStick",
        "controlPad",
