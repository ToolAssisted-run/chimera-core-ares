{
  "coreName": "ares",
  "author": "ares team (Near, Themaister and contributors); RDP by angrylion; chimera port by Sergio Martin",
  "url": "https://github.com/ToolAssisted-run/chimera-core-ares",
  "romFile": "rom",
  "deterministic": true,
  "memoryLayoutMiB": [
    16,
    4,
    16,
    4,
    256
  ],
  "_memoryLayoutMiB_note": "sbrk, sealed, invisible, plain, mmap. musl sends every large allocation to mmap, so that is the one that runs out: a 1MB cartridge already needs more than 80MB there, because the rom is held three times over while loading (mia's vector, the pak's copy, and ares' own Memory::Writable). 256 leaves room for the 64MB carts. The rasteriser's 1.6MB picture buffer is ECL_INVISIBLE, so it costs nothing in a savestate.",
  "video": {
    "_comment": "buffer CAPACITY; the live size comes from GetVideoWidth/Height per frame. The rasteriser always writes 640 across; the height follows the video mode and is doubled for a 240-line picture, so 480 (NTSC) or 576 (PAL).",
    "width": 1280,
    "height": 576,
    "virtualWidth": 640,
    "virtualHeight": 480,
    "vsyncNumerator": 60,
    "vsyncDenominator": 1,
    "getBgra": "GetVideoBgra",
    "_vsync_note": "The NTSC machine's nominal rate; a PAL project gets 50 from GetVsyncNumerator/Denominator, which is what the frontend actually uses. Nominal because the real rate is whatever the game programs the video interface to produce."
  },
  "audio": {
    "samplesPerFrame": 4096,
    "channels": 2,
    "get": "GetAudio"
  },
  "lag": {
    "inputWasRead": "InputWasRead"
  },
  "settings": [
    {
      "name": "machine",
      "display": "Machine",
      "description": "Which console this project is for. It decides everything about the machine, so it reboots the core.",
      "type": "enum",
      "options": [
        "n64",
        "nes",
        "gb",
        "gbc",
        "gen",
        "sms",
        "gg",
        "sg",
        "a26",
        "ws",
        "wsc",
        "zxs",
        "myv"
      ],
      "default": "n64"
    },
    {
      "name": "region",
      "display": "Region",
      "description": "Which console this is. It changes the video timing and the boot ROM, so it changes the machine and reboots the core.",
      "type": "enum",
      "options": [
        "ntsc",
        "pal"
      ],
      "default": "ntsc"
    },
    {
      "name": "port1",
      "display": "Controller Port 1",
      "description": "What is plugged into the first port. The pak options are a gamepad with that accessory in its own slot.",
      "type": "enum",
      "options": [
        "none",
        "gamepad",
        "controllerPak",
        "rumblePak",
        "mouse"
      ],
      "default": "gamepad"
    },
    {
      "name": "port2",
      "display": "Controller Port 2",
      "description": "What is plugged into the second port.",
      "type": "enum",
      "options": [
        "none",
        "gamepad",
        "controllerPak",
        "rumblePak",
        "mouse"
      ],
      "default": "none"
    },
    {
      "name": "port3",
      "display": "Controller Port 3",
      "description": "What is plugged into the third port.",
      "type": "enum",
      "options": [
        "none",
        "gamepad",
        "controllerPak",
        "rumblePak",
        "mouse"
      ],
      "default": "none"
    },
    {
      "name": "port4",
      "display": "Controller Port 4",
      "description": "What is plugged into the fourth port.",
      "type": "enum",
      "options": [
        "none",
        "gamepad",
        "controllerPak",
        "rumblePak",
        "mouse"
      ],
      "default": "none"
    },
    {
      "name": "initialTime",
      "display": "Starting Clock",
      "description": "What the cartridge's real-time clock reads when the machine powers on, in Unix seconds. Only a handful of carts have one. It is a setting rather than the host's clock because a movie replayed next year must build the same machine as today's.",
      "type": "int",
      "min": 0,
      "max": 2147483647,
      "default": 0
    },
    {
      "name": "fastVI",
      "display": "Skip Video Filtering",
      "description": "Skips the video interface's divot, anti-alias and gamma passes. Faster, and a slightly different picture; it does not touch the emulated machine, but it does change what a video encode looks like, so it is recorded.",
      "type": "bool",
      "default": false
    },
    {
      "name": "bobDeinterlace",
      "display": "Bob Deinterlacing",
      "description": "How an interlaced field is doubled into a full frame: bob rather than weave. Picture only.",
      "type": "bool",
      "default": false
    }
  ],
  "_machines_note": "ONE core.wbx, many machines. ares is one emulator for about thirty consoles - the same binary with different hardware built - so this package is all of the ones it can build without asking the user for a console BIOS. What they share stays above; what makes them different machines is below, and it is GENERATED from ares itself by waterbox/gen-config.py, because the order of a controller's buttons is what a movie is written in. Which machine a session is comes from the machine setting, so a project pins it and a movie cites it.",
  "machines": [
