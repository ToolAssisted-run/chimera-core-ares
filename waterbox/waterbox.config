    {
      "name": "initialTime",
      "display": "Starting Clock",
      "description": "What the cartridge's clock shows when the machine is switched on, in seconds since 1970 (Unix time). Only a few cartridges have a clock. This is a setting, and not your computer's clock, so that a movie plays back the same on any day.",
      "type": "int",
      "min": 0,
      "max": 2147483647,
      "default": 0,
      "when": [
        "n64"
      ]
    },
    {
      "name": "fastVI",
      "display": "Skip Video Filtering",
      "description": "Skips three steps the Nintendo 64 applies to its picture (divot removal, anti-aliasing and gamma). It is faster and the picture looks slightly different. The game runs exactly the same. The setting is saved with the project because it changes how a recorded video looks.",
      "type": "bool",
      "default": false,
      "when": [
        "n64"
      ]
    },
    {
      "name": "bobDeinterlace",
      "display": "Bob Deinterlacing",
      "description": "How an interlaced picture is turned into full frames. On, each field is stretched into a frame of its own (bob). Off, two fields are combined into one frame (weave). It changes the picture only.",
      "type": "bool",
      "default": false,
      "when": [
        "n64"
      ]
    },
    {
      "name": "mcd.bios",
      "display": "Which Mega CD BIOS",
      "description": "Which region's Mega CD BIOS to use. A disc only starts with the BIOS of its own region. A USA game needs the Sega CD BIOS, a Japanese game the Japanese Mega CD BIOS and a European game the European one. The Model 1 and Model 2 versions show a different menu, and games behave the same on both.",
      "type": "enum",
      "default": "usa",
      "options": [
        "usa",
        "japan",
        "europe"
      ],
      "when": [
        "mcd",
        "mcd32x"
      ],
      "fromVariants": true
    },
    {
      "name": "pcecd.card",
      "display": "Which System Card",
      "description": "Which System Card is in the card slot. The card is what reads the disc. A Super CD-ROM2 game needs System Card 3.0 of its own region. An early CD-ROM2 game works with any card. A Games Express disc needs the Games Express card. The card shows its name when the machine starts. A disc that stops at PUSH RUN BUTTON usually needs a newer card.",
      "type": "enum",
      "default": "system3-jp",
      "options": [
        "system3-jp",
        "system3-us",
        "system2-jp",
        "system2-us",
        "system1-jp",
        "games-express"
      ],
      "when": [
        "pcecd"
      ],
      "fromVariants": true
    },
    {
      "name": "sms.colorEmulation",
      "display": "Master System: Color Emulation",
      "description": "Shows the colours the way the console's own screen showed them, and not the raw values as a modern display would show them. It changes the recorded picture.",
      "type": "bool",
      "fromAres": true,
      "when": [
        "sms"
      ],
      "default": true
    },
    {
      "name": "sms.revision",
      "display": "Master System: Revision",
      "description": "Which revision of the console this is. Revisions of the real console behave differently in small ways, and a game that depends on one may act differently on another.",
      "type": "enum",
      "fromAres": true,
      "when": [
        "sms"
      ],
      "default": "2",
      "options": [
        "1",
        "2"
      ]
    },
    {
      "name": "gg.interframeBlending",
      "display": "Game Gear: Interframe Blending",
      "description": "Mixes each frame with the one before it, the way the LCD screens of the time blurred movement. The game runs the same. The recorded picture is different, so a movie's video changes when this is on.",
      "type": "bool",
      "fromAres": true,
      "when": [
        "gg"
      ],
      "default": true
    },
    {
      "name": "gg.revision",
      "display": "Game Gear: Revision",
