  "machineSetting": "machine",
  "firmware": [
    {
      "id": "gbBoot",
      "display": "Game Boy boot ROM",
      "description": "The Game Boy's 256-byte boot ROM - the one that scrolls the logo and checks it. ares executes it, and the machine it hands to a cartridge is what the boot ROM left behind, so it is not optional. Nintendo's, and yours to supply. Any of the DMG revisions will do; DMG-CPU A is what ares assumes for a plain Game Boy.",
      "size": 256,
      "sha1": "4ED31EC6B0B175BB109C0EB5FD3D193DA823339F",
      "name": "dmg_boot.bin",
      "requiredWhen": {
        "setting": "machine",
        "is": "gb"
      }
    },
    {
      "id": "gbcBoot",
      "display": "Game Boy Color boot ROM",
      "description": "The Game Boy Color's 2KB boot ROM. Larger than the Game Boy's because it also picks the palette an original Game Boy cartridge is coloured with, which is part of what a game looks like.",
      "size": 2048,
      "sha1": "6F4115B7E55849472D1BD134289EAB937D001246",
      "name": "cgb_boot.bin",
      "requiredWhen": {
        "setting": "machine",
        "is": "gbc"
      }
    },
    {
      "id": "wsBoot",
      "display": "WonderSwan boot ROM",
      "description": "The WonderSwan's boot ROM. It draws the startup animation, sets the machine up, and reads the owner's name out of the internal EEPROM.",
      "size": 4096,
      "sha1": "4015BCACEA76BB0B5BBDB13C5358F7E1ABB986A1",
      "name": "ws_boot.rom",
      "requiredWhen": {
        "setting": "machine",
        "is": "ws"
      }
    },
    {
      "id": "wscBoot",
      "display": "WonderSwan Color boot ROM",
      "description": "The WonderSwan Color's boot ROM, the colour machine's own.",
      "size": 8192,
      "sha1": "C5AD0B8AF45D762662A69F50B64161B9C8919EFB",
      "name": "wsc_boot.rom",
      "requiredWhen": {
        "setting": "machine",
        "is": "wsc"
      }
    },
    {
      "id": "zxsBios",
      "display": "ZX Spectrum BIOS",
      "description": "The 16KB ROM that IS a ZX Spectrum: its BASIC, its editor and its loader. Amstrad's, who permit redistribution with emulators, but not this core's to decide that for you.",
      "size": 16384,
      "sha1": "5EA7C2B824672E914525D1D5C419D71B84A426A2",
      "name": "spectrum.rom",
      "requiredWhen": {
        "setting": "machine",
        "is": "zxs"
      }
    },
    {
      "id": "gbaBios",
      "display": "Game Boy Advance BIOS",
      "description": "The Game Boy Advance's 16KB boot ROM. ares needs the real one: it is executed, games call into it, and its timing is part of the machine. Nintendo's, so it is yours to supply and not this core's to ship.",
      "size": 16384,
      "sha1": "300C20DF6731A33952DED8C436F7F186D25D3492",
      "name": "GBA_bios.rom",
      "requiredWhen": {
        "setting": "machine",
        "is": "gba"
      }
    },
    {
      "id": "cvBios",
      "display": "ColecoVision BIOS",
      "description": "The ColecoVision's 8KB boot ROM - the console's title screen and its cartridge checks live in it, and nothing runs without it.",
      "size": 8192,
      "sha1": "45BEDC4CBDEAC66C7DF59E9E599195C778D86A92",
      "name": "Coleco_Bios.bin",
      "requiredWhen": {
        "setting": "machine",
        "is": "cv"
      }
    },
    {
      "id": "msxBios",
      "display": "MSX BIOS",
      "description": "The MSX's 32KB BIOS and BASIC ROM. Any machine's will do and they differ by region; the one pinned here is what this package was tested against, and a project records which was used.",
      "size": 32768,
      "sha1": "409E82ADAC40F6BDD18EB6C84E8B2FBDC7FB5498",
      "name": "MSX.rom",
      "requiredWhen": {
        "setting": "machine",
        "is": "msx"
      }
    },
    {
      "id": "ps1Bios",
      "display": "PlayStation BIOS",
      "description": "The PlayStation's 512KB boot ROM. It is the console's operating system: games call into it constantly, and the machine reaches nothing without it. Sony's, so it is yours to supply. Any retail BIOS will do and they differ by region and revision; the one pinned here is what this package was tested against, and a project records which was used.",
      "size": 524288,
      "sha1": "14DF4F6C1E367CE097C11DEAE21566B4FE5647A9",
      "name": "PSX_4.1(A).bin",
      "requiredWhen": {
        "setting": "machine",
        "is": "ps1"
      }
    },
    {
      "id": "a52Bios",
      "display": "Atari 5200 BIOS",
      "description": "The Atari 5200's 2KB boot ROM. Exactly 2048 bytes; anything else is refused.",
      "size": 2048,
      "sha1": "6AD7A1E8C9FAD486FBEC9498CB48BF5BC3ADC530",
      "name": "[BIOS] Atari 5200 (USA).a52",
      "requiredWhen": {
        "setting": "machine",
        "is": "a52"
      }
    },
    {
      "id": "ngpBios",
      "display": "Neo Geo Pocket BIOS",
      "description": "The 64KB boot ROM of the original monochrome Neo Geo Pocket, usually named for its 1998 date to tell it from the Color one.",
      "size": 65536,
      "sha1": "2F6429B68446536D8B03F35D02F1E98BEB6460A0",
      "name": "SNK Neo-Geo Pocket BIOS (1998)(SNK)(en-ja).bin",
      "requiredWhen": {
        "setting": "machine",
        "is": "ngp"
      }
    },
    {
      "id": "ngpcBios",
      "display": "Neo Geo Pocket Color BIOS",
      "description": "The 64KB boot ROM of the Neo Geo Pocket Color. A different ROM from the monochrome machine's, and not interchangeable with it.",
      "size": 65536,
      "sha1": "EDC13192054A59BE49C6D55F83B70E2510968E86",
      "name": "SNK Neo-Geo Pocket Color BIOS (1999)(SNK)(en-ja).bin",
      "requiredWhen": {
        "setting": "machine",
        "is": "ngpc"
      }
    },
    {
      "id": "ngBios",
      "display": "Neo Geo AES BIOS",
      "description": "The Neo Geo home console's 128KB boot ROM - `neo-epo.bin`, which is usually found inside an `aes.zip` BIOS set and must be handed over on its own.",
      "size": 131072,
      "sha1": "1B3B22092F30C4D1B2C15F04D1670EB1E9FBEA07",
      "name": "neo-epo.bin",
      "requiredWhen": {
        "setting": "machine",
        "is": "ng"
      }
    },
    {
      "id": "sfcIpl",
      "display": "Super Famicom IPL (SPC700 boot ROM)",
      "description": "The sixty-four bytes the SNES's sound CPU runs at power-on, which is how the main CPU gets any code into it at all. Nothing plays without it. Nintendo's, and yours to supply. Games that carry a coprocessor - the DSP-1 of Pilotwings, the CX4 of Mega Man X2 - need that chip's own ROM as well, which this core does not yet ask for.",
      "size": 64,
      "sha1": "97E352553E94242AE823547CD853EECDA55C20F0",
      "name": "ipl.rom",
      "requiredWhen": {
        "setting": "machine",
        "is": "sfc"
      }
    },
    {
      "id": "m32xVector",
      "display": "Mega 32X vector table",
      "description": "The 256-byte table the 68000 starts from on a 32X. Sega's, and yours to supply. All three 32X files come from the same dump and are usually named for what runs them: G for the Genesis side, M and S for the two SH-2s.",
      "size": 256,
      "sha1": "DBEBD76A448447CB6E524AC3CB0FD19FC065D944",
      "name": "32X_G_BIOS.bin",
      "requiredWhen": {
        "setting": "machine",
        "is": "32x"
      }
    },
    {
      "id": "m32xBootM",
      "display": "Mega 32X master SH-2 boot ROM",
      "description": "The 2KB boot ROM of the first of the 32X's two SH-2 processors.",
      "size": 2048,
      "sha1": "1E5B0B2441A4979B6966D942B20CC76C413B8C5E",
      "name": "32X_M_BIOS.bin",
      "requiredWhen": {
        "setting": "machine",
        "is": "32x"
      }
    },
    {
      "id": "m32xBootS",
      "display": "Mega 32X slave SH-2 boot ROM",
      "description": "The 1KB boot ROM of the second of the 32X's two SH-2 processors.",
      "size": 1024,
      "sha1": "4103668C1BBD66C5E24558E73D4F3F92061A109A",
      "name": "32X_S_BIOS.bin",
      "requiredWhen": {
        "setting": "machine",
        "is": "32x"
      }
    },
    {
      "id": "msx2Main",
      "display": "MSX2 main BIOS",
      "description": "The MSX2's 32KB main ROM. Microsoft's and ASCII's, and yours to supply; an MSX2 needs its sub ROM as well.",
      "size": 32768,
      "sha1": "6103B39F1E38D1AA2D84B1C3219C44F1ABB5436E",
      "name": "msx2.rom",
      "requiredWhen": {
        "setting": "machine",
        "is": "msx2"
      }
    },
    {
      "id": "msx2Sub",
      "display": "MSX2 sub ROM",
      "description": "The MSX2's 16KB sub ROM, which carries the extended BIOS the main ROM calls into.",
      "size": 16384,
      "sha1": "5C1F9C7FB655E43D38E5DD1FCC6B942B2FF68B02",
      "name": "msx2ext.rom",
      "requiredWhen": {
        "setting": "machine",
        "is": "msx2"
      }
    }
  ]
}
